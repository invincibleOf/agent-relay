{
  "name": "agent-relay",
  "version": "0.3.0",
  "description": "CLI local que usa agentes de código (Claude Code, Codex, OpenCode) ejecutándose en una máquina remota, mientras los archivos y comandos se ejecutan en tu máquina. Todo el consumo de IA ocurre en el daemon remoto.",
  "type": "module",
  "license": "MIT",
  "author": "Carlos Alberto Zambrano Braydi",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "relay": "dist/cli/main.js",
    "relay-daemon": "dist/daemon/main.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:daemon": "tsx src/daemon/main.ts",
    "dev:cli": "tsx src/cli/main.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "claude-code",
    "codex",
    "opencode",
    "agents.md",
    "agent-skills",
    "cli"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
